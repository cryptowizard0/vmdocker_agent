# syntax=docker/dockerfile:1.4
FROM golang:1.25 AS builder

WORKDIR /app
COPY go.mod go.sum ./
COPY --from=agent_hub / /tmp/agent-hub
RUN go mod edit -replace github.com/xingj404-lab/agent-hub=/tmp/agent-hub
RUN go mod download

COPY . .
RUN go mod edit -replace github.com/xingj404-lab/agent-hub=/tmp/agent-hub
RUN CGO_ENABLED=0 go build -o /app/main .

FROM sandytest456/hermes-agent:linux-full

USER root
WORKDIR /app

COPY --from=builder /app/main /app/main
COPY start-vmdocker-agent.sh /usr/local/bin/start-vmdocker-agent.sh
COPY bootstrap/hermes.sh /usr/local/lib/vmdocker-agent/bootstrap/hermes.sh

RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
        apt-get update; \
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends curl bash ca-certificates; \
        rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
        apk add --no-cache curl bash ca-certificates; \
    elif command -v microdnf >/dev/null 2>&1; then \
        microdnf install -y curl bash ca-certificates; \
        microdnf clean all; \
    fi

RUN set -eux; \
    python -m pip install --no-cache-dir "python-telegram-bot[webhooks]==22.6"; \
    python -c 'import telegram; print(telegram.__version__)'

RUN set -eux; \
    { \
        echo '#!/bin/sh'; \
        echo 'if [ -n "${HERMES_BROWSER_HARNESS_BIN:-}" ] && [ -x "${HERMES_BROWSER_HARNESS_BIN}" ]; then'; \
        echo '    exec "${HERMES_BROWSER_HARNESS_BIN}" "$@"'; \
        echo 'fi'; \
        echo 'if [ -n "${HOME:-}" ] && [ -x "${HOME}/.local/bin/browser-harness" ]; then'; \
        echo '    exec "${HOME}/.local/bin/browser-harness" "$@"'; \
        echo 'fi'; \
        echo 'if [ -x /root/.local/bin/browser-harness ]; then'; \
        echo '    exec /root/.local/bin/browser-harness "$@"'; \
        echo 'fi'; \
        echo 'echo "browser-harness is not installed for HOME=${HOME:-}" >&2'; \
        echo 'exit 127'; \
    } > /usr/local/bin/browser-harness; \
    chmod +x /usr/local/bin/browser-harness

RUN set -eux; \
    chmod +x /usr/local/bin/start-vmdocker-agent.sh /app/main /usr/local/lib/vmdocker-agent/bootstrap/hermes.sh

RUN set -eux; \
    test -x /usr/local/bin/hermes; \
    test -x /usr/local/lib/vmdocker-agent/bootstrap/hermes.sh

ENV VMDOCKER_AGENT_APP_ROOT=/app
ENV RUNTIME_TYPE=hermes
ENV HOME=/root
ENV SHELL=/bin/bash
ENV PATH=/root/.local/bin:/usr/local/bin:${PATH}
ENV HERMES_AGENT_LLM_PROVIDER=custom
ENV VMDOCKER_AGENT_SKIP_SECURITY_AUDIT=true
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/start-vmdocker-agent.sh"]
