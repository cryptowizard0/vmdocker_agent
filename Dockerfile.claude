FROM golang:1.25 AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /app/main .

FROM docker/sandbox-templates:claude-code

USER root
WORKDIR /app

COPY --from=builder /app/main /app/main
COPY start-vmdocker-agent.sh /usr/local/bin/start-vmdocker-agent.sh
COPY start-vmdocker-agent-workspace.sh /usr/local/bin/start-vmdocker-agent-workspace.sh
COPY bootstrap/claude.sh /usr/local/lib/vmdocker-agent/bootstrap/claude.sh
RUN mkdir -p \
    /opt/vmdocker-agent-bundle/bin \
    /opt/vmdocker-agent-bundle/bootstrap \
    /opt/vmdocker-agent-bundle/profiles \
    /opt/vmdocker-agent-bundle/roles \
    /opt/vmdocker-agent-bundle/skills
COPY start-vmdocker-agent.sh /opt/vmdocker-agent-bundle/bin/start-vmdocker-agent.sh
COPY bootstrap/claude.sh /opt/vmdocker-agent-bundle/bootstrap/claude.sh
COPY harness/profiles/claude /opt/vmdocker-agent-bundle/profiles/claude
COPY harness/roles/claude.md /opt/vmdocker-agent-bundle/roles/claude.md
COPY harness/skills/hymx-runtime /opt/vmdocker-agent-bundle/skills/hymx-runtime

RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
        apt-get update; \
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends curl bash ca-certificates; \
        rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
        apk add --no-cache curl bash ca-certificates; \
    elif command -v microdnf >/dev/null 2>&1; then \
        microdnf install -y curl bash ca-certificates; \
        microdnf clean all; \
    fi

RUN set -eux; \
    usermod -G agent agent; \
    gpasswd -d agent sudo || true; \
    gpasswd -d agent docker || true; \
    rm -f /etc/sudoers.d/agent

RUN set -eux; \
    chmod +x /usr/local/bin/start-vmdocker-agent.sh /usr/local/bin/start-vmdocker-agent-workspace.sh /app/main /usr/local/lib/vmdocker-agent/bootstrap/claude.sh; \
    chmod +x /opt/vmdocker-agent-bundle/bin/start-vmdocker-agent.sh /opt/vmdocker-agent-bundle/bootstrap/claude.sh; \
    rm -rf /home/agent/workspace; \
    chown -R agent:agent /app /usr/local/bin/start-vmdocker-agent.sh /usr/local/lib/vmdocker-agent

RUN set -eux; \
    test ! -e /etc/sudoers.d/agent; \
    command -v claude >/dev/null 2>&1; \
    test -x /usr/local/lib/vmdocker-agent/bootstrap/claude.sh; \
    if command -v sudo >/dev/null 2>&1; then \
        su -s /bin/sh agent -c '! sudo -n true'; \
    fi

ENV VMDOCKER_AGENT_APP_ROOT=/app
ENV RUNTIME_TYPE=claude
ENV HOME=/home/agent
ENV NODE_OPTIONS=--use-env-proxy

USER agent
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/start-vmdocker-agent.sh"]
